{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/index.js": { "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/classic/:path*", "destination": "/api/index" },
    { "source": "/img/:path*", "destination": "/api/index" },
    { "source": "/((?!assets/|favicon|lab-proof|classic\\.css).*)", "destination": "/index.html" }
  ]
}
